# Your library -- audio, video, translations, database. Never commit this:
# it's your data, it's large, and it may contain purchased content.
library/

# Secrets
.env
*.key

# Python
__pycache__/
*.py[cod]
.pytest_cache/
venv/
.venv/
env/
*.egg-info/

# start.bat's own server output log, from its --ci/--server-only launch path
api_server.log
api_server_err.log

# scripts/build_release.py's output (baihe-frontend-<version>.zip)
/dist/

# OS
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/
*.swp

# installer/build_installer.py output (payload, downloaded Python, Setup .exe)
/build/

# Playwright output
/test-results/

# Local smoke pack (clip, baseline, run reports)
/smoke_pack/

# Session-local scratch (screenshots, temp output); never commit
/tmp/

# Chromium that Diagnostics > Install browser support downloads
playwright_browsers/
