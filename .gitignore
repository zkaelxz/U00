# Your library -- audio, video, translations, database. Never commit this:
# it's your data, it's large, and it may contain purchased content.
library/

# Optional personal VTuber name list (licence-restricted: never commit or share).
# A non-installed copy keeps its data folder in this checkout.
/vtuber_names.json
/vtuber_names.json.part

# Secrets
.env
.env.*
!.env.example
*.key

# Python
__pycache__/
*.py[cod]
.pytest_cache/
venv/
.venv/
env/
*.egg-info/

# start.bat's own server output log, from its --ci/--server-only launch path
api_server.log
api_server_err.log

# Installer build output
/dist/

# OS
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/
*.swp

# installer/build_installer.py output (payload, downloaded Python, Setup .exe)
/build/

# Playwright output
/test-results/
/playwright-report/

# Local smoke pack (clip, baseline, run reports)
/smoke_pack/

# Session-local scratch (screenshots, temp output); never commit
/tmp/

# Chromium that Diagnostics > Install browser support downloads
playwright_browsers/

# Other app data a checkout keeps beside the code (portable.data_dir()):
# downloaded models, a queued dependency install, saved comics, tool reports
/model_cache/
/pending_install/
/saved_comics/
/asr-bench-report.md
/self-test-report.txt
/context-bench-report.md

# Personal Claude Code permission overrides
.claude/settings.local.json

# Test, coverage and lint caches
.coverage
coverage/
htmlcov/
.mypy_cache/
.ruff_cache/

# Any stray tool log (the two named above are the server's own)
*.log

# Tool caches created when a command runs from the repo root
node_modules/
