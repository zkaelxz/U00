{
  "name": "baihe-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint --max-warnings 154",
    "preview": "vite preview",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:smoke": "playwright test -c playwright.smoke.config.ts",
    "gen:api": "python ../tools/export_openapi.py openapi-gen/openapi.json && node openapi-gen/node_modules/openapi-typescript/bin/cli.js openapi-gen/openapi.json --default-non-nullable false -o src/api/generated/schema.d.ts && node -e \"require('fs').rmSync('openapi-gen/openapi.json')\""
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "hls.js": "^1.7.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.2.1",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
