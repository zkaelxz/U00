{
  "name": "baihe-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "e2e": "playwright test",
    "gen:api": "python ../tools/export_openapi.py openapi-gen/openapi.json && node openapi-gen/node_modules/openapi-typescript/bin/cli.js openapi-gen/openapi.json -o src/api/generated/schema.d.ts && node -e \"require('fs').rmSync('openapi-gen/openapi.json')\""
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "hls.js": "^1.7.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.89.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
