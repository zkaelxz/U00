<?xml version="1.0" encoding="utf-8"?>
<!-- Same rule for cloud backup and device-to-device transfer on Android 12 and later. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="grab.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="grab.xml" />
    </device-transfer>
</data-extraction-rules>
