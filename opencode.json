{
  "$schema": "https://opencode.ai/config.json",
  "model": "llama/qwen3.6-35b-a3b",
  "instructions": [
    "CLAUDE.md"
  ],
  "permission": {
    "read": {
      "*": "allow",
      "*.test_durations": "deny",
      "*docs/engineering-standards.md": "deny",
      "*docs/archive/*": "deny"
    },
    "bash": {
      "*": "allow",
      "git push*": "ask",
      "git reset*": "ask",
      "git clean*": "ask",
      "git checkout --*": "ask",
      "git restore*": "ask",
      "git rebase*": "ask",
      "git branch -D*": "ask",
      "git stash drop*": "ask",
      "rm -rf*": "ask"
    }
  },
  "provider": {
    "llama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama-server (local)",
      "options": {
        "baseURL": "http://127.0.0.1:8080/v1",
        "apiKey": "sk-local"
      },
      "models": {
        "qwen3.6-35b-a3b": {
          "name": "Qwen3.6-35B-A3B (local)",
          "limit": {
            "context": 65536,
            "output": 8192
          }
        }
      }
    }
  }
}
