# Copy this file to `.env` and fill in whichever keys you use.
# .env is gitignored -- it never gets committed.
# Standard names (ANTHROPIC_API_KEY etc.) are also picked up automatically.

BAIHE_CLAUDE_KEY=sk-ant-...
# BAIHE_DEEPSEEK_KEY=
# BAIHE_OPENAI_KEY=
# BAIHE_HF_TOKEN=

# Local engines (defaults shown)
# BAIHE_OLLAMA_URL=http://localhost:11434
# BAIHE_GPT_SOVITS_URL=http://127.0.0.1:9880

# Monthly spending cap in USD across all translation jobs (0 or unset = none)
# BAIHE_MONTHLY_CAP_USD=20
